# Copy to .env and fill in real values locally. NEVER commit .env.
# Every value below is a placeholder.

# development | test | production  (production refuses to start without a real SESSION_SECRET)
APP_ENV=development
LOG_LEVEL=INFO

# Local without Docker: SQLite file. Docker compose builds a PostgreSQL URL from POSTGRES_PASSWORD.
DATABASE_URL=sqlite:///./app.db
POSTGRES_PASSWORD=replace_with_local_db_password

REDIS_URL=redis://localhost:6379/0
# memory (single API process) | redis (shared across processes)
RATE_LIMIT_BACKEND=memory

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace_with_long_random_secret
SESSION_TTL_HOURS=168

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Set to false after creating your own account on a personal deployment.
ALLOW_REGISTRATION=true

# AI provider. "mock" is deterministic, offline, and needs no key.
# "anthropic" also enables Claude models listed in ALLOWED_MODELS, using AI_API_KEY (server-side only).
AI_PROVIDER=mock
AI_API_KEY=replace_with_secret
# Comma-separated; the first entry is the default for new accounts. Example with Claude:
#   ALLOWED_MODELS=mock-deterministic,claude-opus-5-5
ALLOWED_MODELS=mock-deterministic
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=4000
CHAT_RATE_LIMIT_PER_MINUTE=20
RUN_RATE_LIMIT_PER_MINUTE=30

# inline = run automations in the API process (no Redis needed, good for local demos)
# redis  = hand them to the RQ worker (docker compose, production)
WORKER_MODE=inline

# Web app (server side only; never exposed to the browser).
API_INTERNAL_URL=http://127.0.0.1:8000
